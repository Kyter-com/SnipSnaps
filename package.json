{
  "name": "@kyter/snipsnaps-ios",
  "version": "1.2.0",
  "private": true,
  "description": "Release notes and changelog tooling for SnipSnaps iOS.",
  "packageManager": "npm@11.8.0",
  "scripts": {
    "changeset": "changeset",
    "version": "node scripts/release/ios-release.mjs notes --write-default --allow-empty && changeset version && node scripts/release/ios-release.mjs sync-xcode-version",
    "release:notes": "node scripts/release/ios-release.mjs notes",
    "release:status": "node scripts/release/ios-release.mjs status",
    "release:status:all": "node scripts/release/ios-release.mjs status --platform all",
    "release:status:mac": "node scripts/release/ios-release.mjs status --platform MAC_OS",
    "release:next-build": "node scripts/release/ios-release.mjs next-build",
    "release:next-build:all": "node scripts/release/ios-release.mjs next-build --platform all",
    "release:apply-notes": "node scripts/release/ios-release.mjs apply-notes",
    "release:apply-notes:all": "node scripts/release/ios-release.mjs apply-notes --platform all",
    "release:apply-notes:mac": "node scripts/release/ios-release.mjs apply-notes --platform MAC_OS",
    "release:notes:verify": "node scripts/release/ios-release.mjs verify-notes",
    "release:notes:verify:all": "node scripts/release/ios-release.mjs verify-notes --platform all",
    "release:backfill": "node scripts/release/ios-release.mjs backfill",
    "release:backfill:all": "node scripts/release/ios-release.mjs backfill --platform all",
    "release:tag": "node scripts/release/ios-release.mjs tag"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7"
  }
}
